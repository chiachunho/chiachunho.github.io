    "lint-staged": "^15.2.0",
    "postcss": "^8.4.14",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "tailwindcss": "^3.1.4"
  },
  "husky": {
    "hooks": {
